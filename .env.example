# Waymark environment variables (copy to .env.local and fill in)
# ------------------------------------------------------------------

# Lead-form endpoint (C4.4 / architecture.md TBD-1).
#
# The contact form POSTs JSON here at runtime. Use a static-compatible
# provider — Formspree or Web3Forms (decision pending with the account
# owner). Until this is set, the form falls back to a prefilled mailto:
# link to hello@waymarks.agency, so the flow never dead-ends.
#
# Sandbox proof of the wired path: point it at a Formspree test form
# (or https://webhook.site/ scratch endpoint) and submit once — expect a
# success status from the provider and the "Thanks — we've got it."
# confirmation rendered in the aria-live region.
#
#   Formspree:  https://formspree.io/f/<form-id>
#   Web3Forms:  https://api.web3forms.com/submit  (requires an access_key
#               field added to the payload — see lead-form.tsx)
NEXT_PUBLIC_FORM_ENDPOINT=

# Sanity CMS (headless CMS for content management)
# Deployed separately. Content fetched at build time only.
# If not configured, the site falls back to local content modules.
NEXT_PUBLIC_SANITY_PROJECT_ID=12fmcv53
SANITY_DATASET=production
SANITY_API_TOKEN=skGldpebsyRbb3lCJeydKluqrt6w0m89KXa97ILSA6uvWTPSSTx6frJkIDJ0cdtFdD1MB9gPk8XPUrybAPMNub1RIVt8UF44HINYg8NgRFKAPCnKg7AK4IXAMd51TCnMXLbFfn8rdLRX6AzjAnx82liBduVaGqE5mDpT4Xt2Z5WyafUW4uNj
SANITY_API_VERSION=2025-10-01


# When the provider account exists, also flip `newsletter.enabled` to true
# in src/lib/content/site.ts to reveal the footer newsletter slot (FR-23);
# its submit handler must then post the email field to the same provider.
